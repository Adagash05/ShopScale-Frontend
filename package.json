{
  "name": "shopscale-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ga": "node --test scripts/ga-verify.mjs",
    "test:domains": "node --test scripts/domain-verify.mjs",
    "test:theme": "node --test scripts/theme-verify.mjs",
    "test:partners": "node --test scripts/partners-verify.mjs",
    "test:links": "node --test scripts/notification-links-verify.mjs",
    "test:kitchen": "node scripts/kc-harness/build.mjs && node scripts/kc-harness/out.cjs",
    "test:superadmin": "node scripts/superadmin-harness/build.mjs && node scripts/superadmin-harness/out.cjs",
    "test:help": "node scripts/help-harness/build.mjs && node scripts/help-harness/out.cjs",
    "demo:seed": "node scripts/demo/seed-demo.mjs",
    "help:shots": "node scripts/capture-help-screenshots.mjs",
    "help:shots:verify": "node scripts/verify-help-screenshots.mjs --dist",
    "help:shots:report": "node scripts/help-visual-report.mjs",
    "demo:video": "node scripts/record-demo-video.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@vitejs/plugin-react": "^4.3.3",
    "jsdom": "^25.0.1",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
