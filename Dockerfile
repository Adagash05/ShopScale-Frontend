# docker build --build-arg VITE_API_BASE_URL=https://api.example.com --build-arg VITE_SITE_MODE=unified --build-arg VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX -t shopscale-frontend .   (not run in authoring environment)
FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
ARG VITE_API_BASE_URL
ARG VITE_PUBLIC_SITE_URL
ARG VITE_APP_URL
ARG VITE_SITE_MODE
ARG VITE_GA_MEASUREMENT_ID
ARG VITE_SITE_URL
ARG VITE_SUPPORT_EMAIL
ARG VITE_WHATSAPP_NUMBER
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL VITE_PUBLIC_SITE_URL=$VITE_PUBLIC_SITE_URL VITE_APP_URL=$VITE_APP_URL VITE_SITE_MODE=$VITE_SITE_MODE VITE_GA_MEASUREMENT_ID=$VITE_GA_MEASUREMENT_ID VITE_SITE_URL=$VITE_SITE_URL VITE_SUPPORT_EMAIL=$VITE_SUPPORT_EMAIL VITE_WHATSAPP_NUMBER=$VITE_WHATSAPP_NUMBER
RUN npm run build

FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
