# ShopScale frontend configuration. Copy to .env for local work.
# VITE_* values are public and are baked into the bundle at BUILD time: after changing one (locally or in
# Cloudflare Pages) you must build again. Never put secrets or private keys in any VITE_* variable.

# --- Local development (one origin serves everything) ---
VITE_API_BASE_URL=http://localhost:8080

# --- Production (Cloudflare Pages) ---
# VITE_API_BASE_URL=https://api.shopscale.com.ng
# VITE_PUBLIC_SITE_URL=https://shopscale.com.ng
# VITE_APP_URL=https://app.shopscale.com.ng

# Optional: force a mode instead of detecting it from the hostname: public | app | unified.
# Use "unified" for a single-origin install (Docker/nginx); the production build then needs only VITE_API_BASE_URL.
# VITE_SITE_MODE=

# Optional
VITE_SUPPORT_EMAIL=
VITE_WHATSAPP_NUMBER=
VITE_GA_MEASUREMENT_ID=

# Legacy names still read as fallbacks: VITE_API_URL (= VITE_API_BASE_URL), VITE_SITE_URL (= VITE_PUBLIC_SITE_URL)
